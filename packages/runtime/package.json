{
  "name": "@br/runtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "In-browser sandbox runtime: PreviewHandle (cross-site preview iframe, bridge, watchdog) for imported sites.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "playground": "tsx test-support/dev-server.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@br/protocol": "workspace:*",
    "@br/site": "workspace:*"
  },
  "devDependencies": {
    "@br/config": "workspace:*",
    "@br/sandbox-shell": "workspace:*",
    "@playwright/test": "1.56.1",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
