# @br/capture-worker configuration. Copy to .env (git-ignored) or set in the environment.
# Values below are for the local stack (`supabase start`) and `pnpm dev:shell`.
# NO REAL SECRETS IN THIS FILE.

# Supabase API and the service role key (`supabase status -o env` → API_URL, SERVICE_ROLE_KEY).
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# The capture page. `{build}` is replaced with the build id, for per-build sandbox origins,
# e.g. https://{build}.<usercontent-domain>/v1/capture in production.
CAPTURE_SHELL_URL=http://127.0.0.1:4331/v1/capture

# Shared with the capture gate in front of the shell (Pages secret CAPTURE_HMAC_SECRET).
# At least 32 characters; generate with: openssl rand -hex 32
CAPTURE_HMAC_SECRET=<openssl rand -hex 32>

# Package CDN that serves React for the build's import map (same as the app's preview).
PKG_CDN_URL=http://localhost:4332

# Optional (defaults shown)
# CAPTURE_CONCURRENCY=1
# CAPTURE_TIMEOUT_MS=20000          hard limit for one render
# CAPTURE_SIGNED_URL_TTL_S=120      signed Storage URLs and capture URL lifetime
# WORKER_JOB_TIMEOUT_MS=90000       per job; must stay inside the 2-minute claim lease
# WORKER_IDLE_MIN_MS=1000           polling backoff while the queue is empty
# WORKER_IDLE_MAX_MS=15000
# WORKER_SHUTDOWN_GRACE_MS=30000    on SIGTERM: time to finish the current job before aborting it
# LOG_LEVEL=info
