{
  "name": "@br/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev",
    "dev:sandbox": "tsx scripts/sandbox-servers.ts",
    "dev:solo": "tsx scripts/solo-services.ts --next --start-stack",
    "dev:multi": "tsx scripts/solo-services.ts --next --start-stack --realtime",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build && tsx scripts/pages-config.ts",
    "build:telemetry": "NEXT_PUBLIC_SENTRY_DSN=http://public@127.0.0.1:4399/1 NEXT_PUBLIC_SENTRY_ENVIRONMENT=e2e NEXT_PUBLIC_POSTHOG_KEY=phc_e2e_test NEXT_PUBLIC_POSTHOG_HOST=http://127.0.0.1:4399 pnpm run build",
    "preview": "WRANGLER_SEND_METRICS=false wrangler dev --port 3000 --ip localhost",
    "workers:deploy": "WRANGLER_SEND_METRICS=false wrangler deploy",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "NEXT_TELEMETRY_DISABLED=1 next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "pnpm run build && playwright test",
    "test:e2e:solo": "NEXT_PUBLIC_IMPORT_URL_TEST_ORIGINS=http://host.docker.internal:4330 pnpm run build && playwright test -c playwright.solo.config.ts",
    "test:e2e:moderation": "pnpm run build && playwright test -c playwright.moderation.config.ts",
    "test:e2e:multi": "pnpm run build && playwright test -c playwright.multi.config.ts",
    "test:e2e:mobile": "pnpm run build && playwright test -c playwright.multi.config.ts multiplayer-mobile",
    "test:e2e:chaos": "pnpm run build && playwright test -c playwright.chaos.config.ts",
    "test:e2e:telemetry": "pnpm run build:telemetry && E2E_TELEMETRY=on playwright test -c playwright.telemetry.config.ts && pnpm run build && E2E_TELEMETRY=off playwright test -c playwright.telemetry.config.ts",
    "measure:cpu": "tsx scripts/measure-cpu/main.ts",
    "og-card": "tsx scripts/og-card.ts"
  },
  "dependencies": {
    "@br/game": "workspace:*",
    "@br/protocol": "workspace:*",
    "@br/runtime": "workspace:*",
    "@br/site": "workspace:*",
    "@br/telemetry": "workspace:*",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/inter-tight": "5.3.0",
    "@phosphor-icons/react": "2.1.10",
    "@sentry/browser": "10.75.3",
    "@supabase/supabase-js": "2.117.2",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@br/config": "workspace:*",
    "@br/sandbox-shell": "workspace:*",
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "fflate": "0.8.2",
    "happy-dom": "20.14.5",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vitest": "5.0.3",
    "wrangler": "4.147.0"
  }
}
