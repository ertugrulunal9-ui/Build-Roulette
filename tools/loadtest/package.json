{
  "name": "@br/loadtest",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Load generator for rooms and battles (M5, T-025): scripted supabase-js clients against a Supabase stack, with latency, Realtime, storage and capture metrics, and the cost model.",
  "scripts": {
    "loadtest": "tsx src/main.ts",
    "smoke": "tsx src/main.ts --profile smoke",
    "cost": "tsx src/cost-cli.ts",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@br/config": "workspace:*",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "eslint": "9.39.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
