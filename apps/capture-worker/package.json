{
  "name": "@br/capture-worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Capture and destroy workers: claims jobs from Supabase, renders shipped builds in the signed shell capture page, stores WebP screenshots, deletes ephemeral build files.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --target=node22 --format=esm --external:sharp --external:playwright-core --outfile=dist/main.js --log-level=warning",
    "start": "node dist/main.js",
    "dev": "tsx src/main.ts",
    "dev:shell": "tsx scripts/local-shell.ts",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@br/runtime": "workspace:*",
    "@br/sandbox-shell": "workspace:*",
    "@br/telemetry": "workspace:*",
    "playwright-core": "1.56.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@br/config": "workspace:*",
    "@br/protocol": "workspace:*",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
