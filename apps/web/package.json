{
  "name": "@br/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev",
    "dev:sandbox": "tsx scripts/sandbox-servers.ts",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "NEXT_TELEMETRY_DISABLED=1 next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "NEXT_TELEMETRY_DISABLED=1 next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "pnpm run build && playwright test",
    "cf:build": "NEXT_TELEMETRY_DISABLED=1 WRANGLER_SEND_METRICS=false opennextjs-cloudflare build",
    "cf:preview": "NEXT_TELEMETRY_DISABLED=1 WRANGLER_SEND_METRICS=false opennextjs-cloudflare preview",
    "cf:deploy": "NEXT_TELEMETRY_DISABLED=1 WRANGLER_SEND_METRICS=false opennextjs-cloudflare deploy",
    "test:e2e:cf": "pnpm run cf:build && E2E_APP_SERVER=workers playwright test"
  },
  "dependencies": {
    "@br/game": "workspace:*",
    "@br/protocol": "workspace:*",
    "@br/runtime": "workspace:*",
    "@br/workspace": "workspace:*",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/theme-one-dark": "6.1.3",
    "@codemirror/view": "6.43.13",
    "codemirror": "6.0.2",
    "esbuild-wasm": "0.28.2",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@br/config": "workspace:*",
    "@br/sandbox-shell": "workspace:*",
    "@opennextjs/cloudflare": "1.20.8",
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vitest": "5.0.3",
    "wrangler": "4.147.0"
  }
}
